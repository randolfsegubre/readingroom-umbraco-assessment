{
  "id": "ReadingRoom.Editors",
  "name": "Reading Room Editors",
  "version": "1.8.0",
  "extensions": [
    {
      "type": "propertyEditorUi",
      "alias": "ReadingRoom.PropertyEditorUi.KeyTakeaways",
      "name": "Key Takeaways Property Editor UI",
      "element": "/App_Plugins/ReadingRoom.Editors/key-takeaways.js",
      "meta": {
        "label": "Key Takeaways",
        "icon": "icon-autofill",
        "group": "#propertyEditorUIGroups_common",
        "propertyEditorSchemaAlias": "Umbraco.MultipleTextstring",
        "settings": {
          "properties": [
            {
              "alias": "placeholder",
              "label": "#general_placeholder",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.TextBox"
            }
          ]
        }
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "ReadingRoom.PropertyEditorUi.ReadingLevel",
      "name": "Reading Level Property Editor UI",
      "element": "/App_Plugins/ReadingRoom.Editors/reading-level.js",
      "meta": {
        "label": "Reading Level",
        "icon": "icon-academy",
        "group": "#propertyEditorUIGroups_common",
        "propertyEditorSchemaAlias": "Umbraco.Plain.String"
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "ReadingRoom.PropertyEditorUi.StarRating",
      "name": "Star Rating Property Editor UI",
      "element": "/App_Plugins/ReadingRoom.Editors/star-rating.js",
      "meta": {
        "label": "Star Rating",
        "icon": "icon-rate",
        "group": "#propertyEditorUIGroups_common",
        "propertyEditorSchemaAlias": "Umbraco.Integer"
      }
    },
    {
      "type": "collectionView",
      "alias": "ReadingRoom.CollectionView.ArticleCards",
      "name": "Article Cards Collection View",
      "element": "/App_Plugins/ReadingRoom.Editors/article-cards-view.js",
      "weight": 300,
      "meta": {
        "label": "#readingRoom_articleCards",
        "icon": "icon-grid",
        "pathName": "article-cards"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.CollectionAlias",
          "match": "Umb.Collection.Document"
        }
      ]
    },
    {
      "type": "dashboard",
      "alias": "ReadingRoom.Dashboard.ArticleStats",
      "name": "Article Stats Dashboard",
      "element": "/App_Plugins/ReadingRoom.Editors/article-stats-dashboard.js",
      "weight": -10,
      "meta": {
        "label": "#readingRoom_articleStats",
        "pathname": "article-stats"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ]
    },
    {
      "type": "localization",
      "alias": "ReadingRoom.Localization.En",
      "name": "Reading Room English",
      "meta": {
        "culture": "en",
        "localizations": {
          "readingRoom": {
            "readingLevel": "Reading level",
            "levelNotSet": "Not set",
            "levelBeginner": "Beginner",
            "levelIntermediate": "Intermediate",
            "levelAdvanced": "Advanced",
            "rateStars": "Rate {0} out of {1}",
            "clearRating": "Clear",
            "articleCards": "Article cards",
            "ratedStars": "Rated {0} out of {1}",
            "statePublished": "Published",
            "statePendingChanges": "Published, with changes",
            "stateDraft": "Draft",
            "addTakeaway": "Add takeaway",
            "remove": "Remove",
            "takeawayLabel": "Takeaway {0}",
            "removeTakeawayLabel": "Remove takeaway {0}",
            "limitsMinMax": "Takeaways: minimum {0}, maximum {1}",
            "limitsMax": "Takeaways: maximum {0}",
            "limitsMin": "Takeaways: minimum {0}",
            "tooFew": "Add at least {0} takeaways. There are {1} now.",
            "tooMany": "The maximum is {0} takeaways. There are {1} now.",
            "moveUpLabel": "Move takeaway {0} up",
            "moveDownLabel": "Move takeaway {0} down",
            "articleStats": "Article stats",
            "publishedArticles": "Published articles:",
            "latestArticles": "Latest articles",
            "statsLoadFailed": "The article statistics could not be loaded (status {0})."
          }
        }
      }
    },
    {
      "type": "localization",
      "alias": "ReadingRoom.Localization.Es",
      "name": "Reading Room Spanish",
      "meta": {
        "culture": "es",
        "localizations": {
          "readingRoom": {
            "readingLevel": "Nivel de lectura",
            "levelNotSet": "Sin definir",
            "levelBeginner": "Principiante",
            "levelIntermediate": "Intermedio",
            "levelAdvanced": "Avanzado",
            "rateStars": "Valorar con {0} de {1}",
            "clearRating": "Borrar",
            "articleCards": "Tarjetas de artículos",
            "ratedStars": "Valoración de {0} sobre {1}",
            "statePublished": "Publicado",
            "statePendingChanges": "Publicado, con cambios",
            "stateDraft": "Borrador",
            "addTakeaway": "Añadir punto clave",
            "remove": "Eliminar",
            "takeawayLabel": "Punto clave {0}",
            "removeTakeawayLabel": "Eliminar punto clave {0}",
            "limitsMinMax": "Puntos clave: mínimo {0}, máximo {1}",
            "limitsMax": "Puntos clave: máximo {0}",
            "limitsMin": "Puntos clave: mínimo {0}",
            "tooFew": "Añade al menos {0} puntos clave. Ahora hay {1}.",
            "tooMany": "El máximo es de {0} puntos clave. Ahora hay {1}.",
            "moveUpLabel": "Subir el punto clave {0}",
            "moveDownLabel": "Bajar el punto clave {0}",
            "articleStats": "Estadísticas de artículos",
            "publishedArticles": "Artículos publicados:",
            "latestArticles": "Últimos artículos",
            "statsLoadFailed": "No se pudieron cargar las estadísticas de los artículos (estado {0})."
          }
        }
      }
    }
  ]
}
