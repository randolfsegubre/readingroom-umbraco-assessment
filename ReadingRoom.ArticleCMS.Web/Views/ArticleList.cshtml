@inherits UmbracoViewPage<ArticleList>
@using ReadingRoom.ArticleCMS.Core.Constants
@{
    IEnumerable<Article> articles = Model.Children<Article>()
        .OrderByDescending(article => article.PublishDate);
}

@if (Model.HeroBanner is not null)
{
    @* the picture is decoration, so it has an empty alternative text *@
    <img class="hero-banner rounded mb-4" src="@Model.HeroBanner.Url()" alt="" width="1200" height="320" />
}

<h1 class="mb-4">@Model.Name</h1>

@if (articles.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (Article article in articles)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (article.HeroImage is not null)
                    {
                        <img class="card-img-top" src="@article.HeroImage.Url()" alt="@article.Title" />
                    }
                    <div class="card-body">
                        <h2 class="h5 card-title">
                            <a class="stretched-link text-decoration-none" href="@article.Url()">@article.Title</a>
                        </h2>
                        <p class="card-text">@article.Intro</p>
                    </div>
                    <div class="card-footer text-body-secondary small">
                        <time datetime="@article.PublishDate.ToString(DateFormats.MachineReadable)">@article.PublishDate.ToString(DateFormats.Display)</time>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-body-secondary">@Umbraco.GetDictionaryValueOrDefault(DictionaryKeys.ArticleListNoArticles, "There are no articles yet.")</p>
}
