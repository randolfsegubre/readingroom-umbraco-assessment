@inherits UmbracoViewPage<Article>
@using ReadingRoom.ArticleCMS.Core.ReadingTime
@using ReadingRoom.ArticleCMS.Core.Constants
@inject IReadingTimeService ReadingTimeCalculator
@{
    Layout = "_Layout";
    ArticleList? articleList = Model.Parent<ArticleList>();
    int readingMinutes = ReadingTimeCalculator.GetMinutes(Model.Body?.ToHtmlString());

    List<string> takeaways = new List<string>();
    foreach (string takeaway in Model.TakeawaysList ?? Enumerable.Empty<string>())
    {
        if (!string.IsNullOrWhiteSpace(takeaway))
        {
            takeaways.Add(takeaway);
        }
    }
}

<article class="article-container">
    <h1 class="display-6 mb-2">@Model.Title</h1>

    <p class="text-body-secondary mb-4">
        <time datetime="@Model.PublishDate.ToString(DateFormats.MachineReadable)">@Model.PublishDate.ToString(DateFormats.Display)</time>
        @if (readingMinutes > 0)
        {
            <span class="badge text-bg-secondary ms-2">~@readingMinutes min read</span>
        }
    </p>

    @if (Model.HeroImage is not null)
    {
        <figure class="mb-4">
            <img class="img-fluid rounded" src="@Model.HeroImage.Url()" alt="@Model.Title" width="1200" height="675" />
        </figure>
    }

    <p class="lead">@Model.Intro</p>

    @if (takeaways.Count > 0)
    {
        <aside class="card border-primary-subtle bg-primary-subtle mb-4">
            <div class="card-body">
                <h2 class="h5">Key takeaways</h2>
                <ul class="mb-0">
                    @foreach (string takeaway in takeaways)
                    {
                        <li>@takeaway</li>
                    }
                </ul>
            </div>
        </aside>
    }

    <div class="article-body">
        @Model.Body
    </div>

    @if (articleList is not null)
    {
        <a class="btn btn-outline-secondary mt-4" href="@articleList.Url()">Back to all articles</a>
    }
</article>
