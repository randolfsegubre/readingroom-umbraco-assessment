@inherits UmbracoViewPage
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Name | Article CMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <header class="navbar bg-dark" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="/">Article CMS</a>
        </div>
    </header>
    <main class="container py-4">
        @RenderBody()
    </main>
    <footer class="container py-4 text-body-secondary small">
        Built with Umbraco 17 and .NET 10
    </footer>
</body>
</html>
