<?xml version="1.0" encoding="utf-8"?>
<DataType Key="147dcbb2-efe3-47be-8d21-07f1a0bcbbf4" Alias="Articles Collection" Level="1">
  <Info>
    <Name>Articles Collection</Name>
    <EditorAlias>Umbraco.ListView</EditorAlias>
    <EditorUIAlias>Umb.PropertyEditorUi.Collection</EditorUIAlias>
  </Info>
  <Config><![CDATA[{
  "includeProperties": [
    {
      "alias": "publishDate",
      "header": "Publish date",
      "isSystem": false
    },
    {
      "alias": "readingLevel",
      "header": "Reading level",
      "isSystem": false
    },
    {
      "alias": "editorRating",
      "header": "Rating",
      "isSystem": false
    }
  ],
  "layouts": [
    {
      "name": "Article cards",
      "collectionView": "ReadingRoom.CollectionView.ArticleCards",
      "icon": "icon-grid",
      "selected": true
    },
    {
      "name": "List",
      "collectionView": "Umb.CollectionView.Document.Table",
      "icon": "icon-list",
      "isSystem": true,
      "selected": true
    }
  ],
  "orderBy": "publishDate",
  "orderDirection": "desc",
  "pageSize": 20
}]]></Config>
</DataType>